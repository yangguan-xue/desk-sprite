#!/usr/bin/env python3
"""Desk Sprite Mac 守护进程入口脚本 (SPEC-004 第 3.2 节, TASK-012, R04)"""

import argparse
import logging
import os
import signal
import sys
import time
from pathlib import Path

# 添加工程根目录至 sys.path
PROJECT_ROOT = Path(__file__).resolve().parent.parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from cli.sprite.config import load_config
from cli.sprite.daemon.app_monitor import AppMonitor
from cli.sprite.daemon.command_executor import CommandExecutor
from cli.sprite.daemon.mqtt_worker import DaemonMQTTWorker
from cli.sprite.daemon.screen_monitor import ScreenMonitor

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
)
logger = logging.getLogger("sprite-daemon")


def get_pid_file() -> Path:
    config_dir = Path.home() / ".sprite"
    config_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    return config_dir / "daemon.pid"


def is_pid_running(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def run_daemon():
    pid_file = get_pid_file()
    if pid_file.exists():
        try:
            old_pid = int(pid_file.read_text().strip())
            if is_pid_running(old_pid):
                logger.error(f"Daemon already running with PID {old_pid}")
                sys.exit(1)
        except Exception:
            pass

    try:
        config = load_config()
    except Exception as e:
        logger.error(f"Failed to load configuration: {e}")
        sys.exit(1)

    pid = os.getpid()
    pid_file.write_text(str(pid))
    try:
        pid_file.chmod(0o600)
    except Exception:
        pass

    executor = CommandExecutor(host_id=config.host_id)
    worker = DaemonMQTTWorker(config=config, executor=executor)

    def handle_mode_change(new_mode):
        logger.info(f"State transition: -> {new_mode.value}")
        worker.publish_work_mode(new_mode.value)

    app_mon = AppMonitor(on_mode_change=handle_mode_change)

    def on_locked():
        logger.info("Screen locked event received, transitioning to sleep immediately")
        app_mon.set_screen_locked(True)

    def on_unlocked():
        logger.info("Screen unlocked event received, triggering refresh")
        app_mon.set_screen_locked(False)

    screen_mon = ScreenMonitor(on_locked=on_locked, on_unlocked=on_unlocked)

    # 优雅停机信号处理
    running = True

    def sig_handler(signum, frame):
        nonlocal running
        logger.info(f"Received signal {signum}, initiating graceful shutdown...")
        running = False

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)

    try:
        logger.info(f"Starting Desk Sprite Daemon (PID: {pid}, Host: {config.host_id})...")
        worker.start()
        screen_mon.start()

        while running:
            app_mon.poll_tick()
            time.sleep(1.0)
    finally:
        logger.info("Cleaning up daemon resources...")
        screen_mon.stop()
        worker.stop()
        if pid_file.exists():
            try:
                pid_file.unlink()
            except Exception:
                pass
        logger.info("Desk Sprite Daemon exited cleanly.")


def stop_daemon() -> int:
    pid_file = get_pid_file()
    if not pid_file.exists():
        print("Daemon is not running (no PID file)")
        return 0

    try:
        pid = int(pid_file.read_text().strip())
    except Exception:
        pid_file.unlink(missing_ok=True)
        print("Invalid PID file removed")
        return 0

    if not is_pid_running(pid):
        print(f"Daemon process {pid} is not running (stale PID file cleaned)")
        pid_file.unlink(missing_ok=True)
        return 0

    print(f"Stopping daemon (PID: {pid})...")
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(30):
            time.sleep(0.1)
            if not is_pid_running(pid):
                break
        else:
            print("Force killing daemon...")
            os.kill(pid, signal.SIGKILL)
    except Exception as e:
        print(f"Failed to kill daemon: {e}")
        return 1

    if pid_file.exists():
        pid_file.unlink(missing_ok=True)
    print("Daemon stopped.")
    return 0


def status_daemon() -> int:
    pid_file = get_pid_file()
    if not pid_file.exists():
        print("Daemon is stopped")
        return 1

    try:
        pid = int(pid_file.read_text().strip())
    except Exception:
        print("Corrupted PID file")
        return 1

    if is_pid_running(pid):
        print(f"Daemon is running (PID: {pid})")
        return 0
    else:
        print(f"Daemon is stopped (stale PID: {pid})")
        return 1


def main():
    parser = argparse.ArgumentParser(description="Desk Sprite Mac 守护进程管理")
    parser.add_argument("action", choices=["run", "stop", "status"], help="动作")
    args = parser.parse_args()

    if args.action == "run":
        run_daemon()
    elif args.action == "stop":
        sys.exit(stop_daemon())
    elif args.action == "status":
        sys.exit(status_daemon())


if __name__ == "__main__":
    main()
