menu "Desk Sprite Configuration"

    config SPRITE_MQTT_BROKER_URL
        string "MQTT Broker URI"
        default "mqtt://127.0.0.1:1883"
        help
            URI of the MQTT broker, e.g. mqtt://192.168.1.100:1883 or mqtts://...

    config SPRITE_MQTT_CA_CERT
        string "Custom CA Certificate (PEM format or empty to use ESP x509 Bundle)"
        default ""
        help
            Optional PEM-formatted CA certificate used to verify the MQTT broker.
            If left empty, the built-in ESP x509 Certificate Bundle (esp_crt_bundle_attach) will be used.

    config SPRITE_MQTT_BROKER_COMMON_NAME
        string "Server Certificate Common Name"
        default ""
        help
            Expected common name (CN) of the broker's TLS certificate.
            If left empty, the host from the broker URI is matched.

    config SPRITE_DEVICE_ID
        string "Device ID"
        default "esp32_c049ef"
        help
            Unique device ID for Desk Sprite.

    config SPRITE_SNTP_SERVER
        string "SNTP Server"
        default "pool.ntp.org"
        help
            SNTP server to sync clock.

    config SPRITE_ENABLE_TOUCH_ACTIONS
        bool "Enable Native Touch Action Reporting"
        default n
        help
            Enable physical touch action reporting to cloud. Defaults to disabled
            per SPEC-005/007 until physical capacitance calibration is accepted.

endmenu
